{
  "name": "image-optimizer",
  "private": true,
  "version": "0.6.10",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "lint": "biome check . && npm run lint:rust",
    "lint:fix": "biome check --write . && npm run lint:rust",
    "lint:rust": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
    "format": "biome format --write .",
    "version": "node scripts/sync-version.js && git add src-tauri/Cargo.toml src-tauri/Cargo.lock src-tauri/tauri.conf.json",
    "version:sync": "node scripts/sync-version.js",
    "sync": "npm run lint:fix && npm run version:sync"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-os": "^2.4.0",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-store": "^2.5.1",
    "@tauri-apps/plugin-updater": "^2.14.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sass": "^1.108.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@tauri-apps/cli": "^2.12.4",
    "@vitejs/plugin-react": "^6.3.0",
    "vite": "^8.3.7"
  }
}
